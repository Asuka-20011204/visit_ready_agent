# demo 仅用于无密钥的界面和流程演练；正式答辩必须改为 live。
APP_MODE=demo
APP_PORT=8097
APP_VERSION=dev
APP_COMMIT=local

# live 模式默认要求账户登录并使用 MySQL；demo 默认关闭账户认证。
# 本地 HTTP 调试 live 时设 AUTH_COOKIE_SECURE=false；公网 HTTPS 必须保留 true。
AUTH_MODE=
AUTH_COOKIE_SECURE=

# OpenAI-compatible /v1/chat/completions endpoint (live 模式必填)
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# 可选。留空时跳过联网资料检索，事实整理仍可继续。
BOCHA_ENDPOINT=https://api.bochaai.com/v1/web-search
BOCHA_API_KEY=

# memory: 服务重启即清空; mysql: 使用 MYSQL_DSN 持久化会话
SESSION_STORE=memory
# 使用 compose.mysql.yaml 时必须留空；直接连接已有/托管 MySQL 时填写完整 DSN
MYSQL_DSN=
# compose.mysql.yaml 使用此值创建 MySQL 用户；外部 MySQL 时须与 MYSQL_DSN 中密码一致
MYSQL_PASSWORD=
# Windows PowerShell 5.1/7: $bytes=New-Object byte[] 32; $rng=[Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($bytes); $rng.Dispose(); [Convert]::ToBase64String($bytes).TrimEnd('=').Replace('+','-').Replace('/','_')
# Unix shell: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SESSION_ENCRYPTION_KEY=

# 单次上游(LLM/检索)请求上限; 整个就诊整理工作流(多次串行调用)上限见 WORKFLOW_TIMEOUT
UPSTREAM_TIMEOUT=25s
# Compose 固定使用 45s，直接 go run 时使用此值；任何超过 45s 的值会被拒绝启动。
WORKFLOW_TIMEOUT=45s

# debug / info / warn / error。debug 时输出每条上游调用与耗时,便于定位超时
LOG_LEVEL=info

SESSION_TTL=24h
SESSION_CLEANUP_INTERVAL=1m
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=2m
