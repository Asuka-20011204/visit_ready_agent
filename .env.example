# demo 仅用于无密钥的界面和流程演练；正式答辩必须改为 live。
APP_MODE=demo
APP_PORT=8080
APP_VERSION=dev
APP_COMMIT=local

# OpenAI-compatible /v1/chat/completions endpoint (live 模式必填)
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# 可选。留空时跳过联网资料检索，事实整理仍可继续。
TAVILY_ENDPOINT=https://api.tavily.com/search
TAVILY_API_KEY=

SESSION_TTL=30m
SESSION_CLEANUP_INTERVAL=1m
UPSTREAM_TIMEOUT=25s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=55s
